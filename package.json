{
  "name": "novapulse-grpc",
  "version": "1.0.0",
  "description": "NovaPulse - Smart City gRPC Nervous System using gRPC",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "web": "node server/index.js",
    "client:traffic": "node client/trafficClient.js",
    "client:environment": "node client/environmentClient.js",
    "client:emergency": "node client/emergencyClient.js",
    "client:dashboard": "node client/dashboard.js",
    "mqtt:broker": "node mqtt/broker/mqttBroker.js",
    "mqtt:pub:traffic": "node mqtt/publishers/trafficPublisher.js",
    "mqtt:pub:environment": "node mqtt/publishers/environmentPublisher.js",
    "mqtt:pub:emergency": "node mqtt/publishers/emergencyPublisher.js",
    "mqtt:sub:command-center": "node mqtt/subscribers/commandCenterSub.js",
    "mqtt:sub:public-alert": "node mqtt/subscribers/publicAlertSub.js",
    "mqtt:sub:public-alert-2": "node mqtt/subscribers/publicAlertSub.js 2",
    "mqtt:dashboard": "node mqtt/dashboard/server.js",
    "start:all": "node scripts/start-local.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.0",
    "aedes": "^0.51.3",
    "chalk": "^4.1.2",
    "express": "^5.2.1",
    "mqtt": "^4.3.8",
    "net": "^1.0.2",
    "readline": "^1.3.0",
    "uuid": "^9.0.0",
    "ws": "^8.20.0"
  },
  "keywords": [
    "grpc",
    "smart-city",
    "monitoring",
    "streaming"
